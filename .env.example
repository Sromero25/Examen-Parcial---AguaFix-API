# Obligatoria: puerto interno de la API.
PORT=3000

# Obligatoria: conexión PostgreSQL. En el Compose local DB_HOST debe ser "db".
DB_HOST=db
DB_PORT=5432
DB_USERNAME=aguafix_local_user
DB_PASSWORD=replace-with-a-local-secret
DB_NAME=aguafix_local

# Obligatoria: notificaciones por correo.
MAILER_SERVICE=example-mail-service
MAILER_EMAIL=notifications@example.invalid
MAILER_SECRET_KEY=replace-with-a-mailer-secret
MAINTENANCE_EMAIL=maintenance@example.invalid

# Obligatoria: almacenamiento S3.
AWS_REGION=us-east-2
AWS_S3_BUCKET=aguafix-fotos-us-east-2-eq1-2026

# Opcionales: omitir ambas en EC2 para usar el IAM Role y la cadena de
# credenciales predeterminada del SDK de AWS. Si se definen, deben definirse juntas.
# AWS_ACCESS_KEY_ID=example-access-key-id
# AWS_SECRET_ACCESS_KEY=example-secret-access-key
